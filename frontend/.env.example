# Express backend (garments API). Leave unset to fall back to http://localhost:8000.
# In production, set this in Vercel → Project Settings → Environment Variables.
VITE_BACKEND_URL=https://your-backend.onrender.com

# FastAPI AI service (/pose endpoint). Leave unset to fall back to http://localhost:8001.
VITE_AI_API=https://your-ai-service.onrender.com
